<mxfile host="app.diagrams.net"><diagram name="System Context" id="ctx"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1270" pageHeight="430"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="System Context Diagram · DW Control SW" style="text;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="520" height="30" as="geometry"/></mxCell><mxCell id="btn" value="«device»&lt;br&gt;&lt;b&gt;Buttons ×4&lt;/b&gt;&lt;br&gt;MODE · SET · ADJUST · LIGHT" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="tmr" value="«device»&lt;br&gt;&lt;b&gt;Time Source&lt;/b&gt;&lt;br&gt;HW Timer (SW controller 내장)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="250" height="100" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b&gt;DW Control SW&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff8d6;strokeColor=#7a5c00;strokeWidth=1.6;fontSize=18;" vertex="1" parent="1"><mxGeometry x="520" y="160" width="200" height="110" as="geometry"/></mxCell><mxCell id="lcd" value="«device»&lt;br&gt;&lt;b&gt;LCD&lt;/b&gt;&lt;br&gt;(+ Backlight)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="980" y="70" width="250" height="100" as="geometry"/></mxCell><mxCell id="bz" value="«device»&lt;br&gt;&lt;b&gt;Buzzer&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="980" y="260" width="250" height="100" as="geometry"/></mxCell><mxCell id="e0" value="누름 / 뗌&lt;br&gt;(press / release)" style="endArro