<mxfile host="app.diagrams.net"><diagram name="System Context" id="ctx"><mxGraphModel grid="1" gridSize="10" page="1" pageWidth="1290" pageHeight="560"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="System Context Diagram · DW Control SW" style="text;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="520" height="30" as="geometry"/></mxCell><mxCell id="bh" value="«device»&lt;br&gt;&lt;b&gt;ButtonHandler&lt;/b&gt;&lt;br&gt;MODE · SET · ADJUST · LIGHT 버튼 해석" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="290" height="130" as="geometry"/></mxCell><mxCell id="tmr" value="«device»&lt;br&gt;&lt;b&gt;Time Source&lt;/b&gt;&lt;br&gt;HW Timer (SW controller 내장)" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="290" height="100" as="geometry"/></mxCell><mxCell id="sw" value="&lt;b&gt;DW Control SW&lt;/b&gt;" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#fff8d6;strokeColor=#7a5c00;strokeWidth=1.6;fontSize=18;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="200" height="300" as="geometry"/></mxCell><mxCell id="lcd" value="«device»&lt;br&gt;&lt;b&gt;LCDDriver&lt;/b&gt;&lt;br&gt;LCD 화면 · 백라이트 제어" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="130" width="250" height="100" as="geometry"/></mxCell><mxCell id="bz" value="«device»&lt;br&gt;&lt;b&gt;BuzzerDriver&lt;/b&gt;&lt;br&gt;부저 제어" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#eef2fa;strokeColor=#3b5b92;strokeWidth=1.6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1000" y="300" width="250" height="100" as="geometry"/></mxCell><mxCell id="e0" value="System Operations&lt;br&gt;changeMode(), startSetting(), …" style="endArrow=block;endFill=1;html=1;strokeWidth=1.6;fontSize=13;fontColor=#1a4f9c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;entryX=0;entryY=0.13;" edge="1" parent="1" source="bh" target="sw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e1" value="현재 상태 조회&lt;br&gt;(모드 · 설정 중 · 경보 중 · 타이머 동작)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.6;fontSize=13;fontColor=#1a4f9c;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.33;entryX=1;entryY=0.78;" edge="1" parent="1" source="sw" target="bh"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="tick()&lt;br&gt;(1초 인터럽트)" style="endArrow=block;endFill=1;html=1;strokeWidth=1.6;fontSize=13;fontColor=#1a4f9c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.82;" edge="1" parent="1" source="tmr" target="sw"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="화면 표시 · 깜빡임&lt;br&gt;백라이트 on/off" style="endArrow=block;endFill=1;html=1;strokeWidth=1.6;fontSize=13;fontColor=#1a4f9c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.27;entryX=0;entryY=0.5;" edge="1" parent="1" source="sw" target="lcd"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" value="경보음 on/off" style="endArrow=block;endFill=1;html=1;strokeWidth=1.6;fontSize=13;fontColor=#1a4f9c;labelBackgroundColor=#ffffff;exitX=1;exitY=0.67;entryX=0;entryY=0.5;" edge="1" parent="1" source="sw" target="bz"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="note0" value="시스템 경계 = DW Control SW. 외부 요소는 «device»로 표기한다. ButtonHandler(입력)와 LCDDriver · BuzzerDriver(출력)는 하드웨어를 다루는 플랫폼 SW로 보고 경계 밖에 둔다." style="text;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="502" width="1100" height="22" as="geometry"/></mxCell><mxCell id="note1" value="SW controller에 내장된 HW Timer도 SW 입장에서는 외부 장치로 본다." style="text;fontSize=12;fontColor=#666666;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="522" width="1100" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>